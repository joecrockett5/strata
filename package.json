{
  "name": "strata",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @strata/editor dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "gen:api": "pnpm --filter @strata/api-client gen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:schema": "pnpm --filter @strata/schema gen",
    "gen": "pnpm gen:schema && pnpm gen:api",
    "parity:generate": "pnpm --filter @strata/renderer parity:generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
