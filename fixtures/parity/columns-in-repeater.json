{
  "description": "Repeater (grid-3) whose items contain Columns (1:2, stacking on mobile) of Image + Heading + RichText; per-item values, one item using defaults, and a second repeater rendering its default item count.",
  "kind": "section",
  "theme": {
    "colors": {
      "primary": "#1f4e5f",
      "onPrimary": "#ffffff",
      "secondary": "#4a6b5d",
      "accent": "#c9822b",
      "background": "#ffffff",
      "surface": "#f3f5f4",
      "text": "#1c2321",
      "mutedText": "#55605c"
    },
    "fonts": {
      "heading": "transitional",
      "body": "system-ui"
    },
    "radius": "small"
  },
  "context": {
    "site": {
      "firmName": "Harbor & Pine Wealth Partners",
      "logo": {
        "$type": "image",
        "mediaId": "22222222-2222-4222-8222-00000000000c",
        "alt": "Harbor & Pine logo"
      },
      "homeHref": "/s/demo/",
      "nav": [
        {
          "pageId": "11111111-1111-4111-8111-000000000001",
          "title": "Home",
          "href": "/s/demo/",
          "current": true
        },
        {
          "pageId": "11111111-1111-4111-8111-000000000002",
          "title": "About",
          "href": "/s/demo/about",
          "current": false
        },
        {
          "pageId": "11111111-1111-4111-8111-000000000003",
          "title": "Contact",
          "href": "/s/demo/contact",
          "current": false
        }
      ]
    },
    "pageHrefs": {
      "11111111-1111-4111-8111-000000000001": "/s/demo/",
      "11111111-1111-4111-8111-000000000002": "/s/demo/about",
      "11111111-1111-4111-8111-000000000003": "/s/demo/contact"
    },
    "mediaBase": "/media/",
    "formAction": "/s/demo/_contact",
    "pageId": "11111111-1111-4111-8111-000000000001"
  },
  "definition": {
    "schemaVersion": 1,
    "root": {
      "$type": "section",
      "id": "root",
      "background": "background",
      "paddingY": "lg",
      "width": "wide",
      "children": [
        {
          "$type": "heading",
          "id": "title",
          "level": 2,
          "align": "center",
          "text": {
            "key": "title",
            "label": "title",
            "type": "text",
            "mode": "editable",
            "required": false,
            "default": {
              "$type": "text",
              "text": "Meet the team"
            }
          }
        },
        {
          "$type": "repeater",
          "id": "team",
          "key": "team",
          "itemLabel": "Item",
          "min": 1,
          "max": 6,
          "defaultItemCount": 3,
          "layout": "grid-3",
          "gap": "lg",
          "children": [
            {
              "$type": "columns",
              "id": "member",
              "ratio": "1:2",
              "gap": "md",
              "valign": "center",
              "stackAt": "mobile",
              "columns": [
                {
                  "children": [
                    {
                      "$type": "image",
                      "id": "photo",
                      "aspect": "1:1",
                      "fit": "cover",
                      "radius": "full",
                      "image": {
                        "key": "photo",
                        "label": "photo",
                        "type": "image",
                        "mode": "editable",
                        "required": true,
                        "default": {
                          "$type": "image",
                          "mediaId": null,
                          "alt": ""
                        }
                      }
                    }
                  ]
                },
                {
                  "children": [
                    {
                      "$type": "heading",
                      "id": "name",
                      "level": 3,
                      "align": "start",
                      "text": {
                        "key": "name",
                        "label": "name",
                        "type": "text",
                        "mode": "editable",
                        "required": false,
                        "default": {
                          "$type": "text",
                          "text": "Team member"
                        }
                      }
                    },
                    {
                      "$type": "richText",
                      "id": "bio",
                      "align": "start",
                      "content": {
                        "key": "bio",
                        "label": "bio",
                        "type": "richText",
                        "mode": "editable",
                        "required": false,
                        "default": {
                          "$type": "richText",
                          "html": "<p>Short bio.</p>"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "$type": "repeater",
          "id": "steps",
          "key": "steps",
          "itemLabel": "Item",
          "min": 2,
          "max": 5,
          "defaultItemCount": 2,
          "layout": "grid-2",
          "gap": "md",
          "children": [
            {
              "$type": "heading",
              "id": "step",
              "level": 4,
              "align": "start",
              "text": {
                "key": "stepTitle",
                "label": "stepTitle",
                "type": "text",
                "mode": "editable",
                "required": false,
                "default": {
                  "$type": "text",
                  "text": "Step"
                }
              }
            },
            {
              "$type": "richText",
              "id": "stepBody",
              "align": "start",
              "content": {
                "key": "stepBody",
                "label": "stepBody",
                "type": "richText",
                "mode": "editable",
                "required": false,
                "default": {
                  "$type": "richText",
                  "html": "<p>Describe this step.</p>"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "instance": {
    "id": "aaaaaaaa-0000-4000-8000-000000000003",
    "sectionTypeId": "bbbbbbbb-0000-4000-8000-000000000003",
    "version": 1,
    "lock": "none",
    "hidden": false,
    "values": {},
    "repeaters": {
      "team": [
        {
          "id": "cccccccc-0000-4000-8000-000000000001",
          "values": {
            "photo": {
              "$type": "image",
              "mediaId": "22222222-2222-4222-8222-00000000000a",
              "alt": "Maya Chen"
            },
            "name": {
              "$type": "text",
              "text": "Maya Chen, CFP®"
            },
            "bio": {
              "$type": "richText",
              "html": "<p>Maya leads <strong>retirement</strong> planning.</p>"
            }
          }
        },
        {
          "id": "cccccccc-0000-4000-8000-000000000002",
          "values": {
            "photo": {
              "$type": "image",
              "mediaId": "22222222-2222-4222-8222-00000000000b",
              "alt": "Daniel Ortiz"
            },
            "name": {
              "$type": "text",
              "text": "Daniel Ortiz"
            }
          }
        },
        {
          "id": "cccccccc-0000-4000-8000-000000000003",
          "values": {}
        }
      ]
    }
  }
}
