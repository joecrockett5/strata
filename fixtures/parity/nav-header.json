{
  "description": "Header-style section on the primary background: Columns (3:1) with Nav (logo, firm name, links, current page) and a Book-a-call button.",
  "kind": "section",
  "theme": {
    "colors": {
      "primary": "#1f4e5f",
      "onPrimary": "#ffffff",
      "secondary": "#4a6b5d",
      "accent": "#c9822b",
      "background": "#ffffff",
      "surface": "#f3f5f4",
      "text": "#1c2321",
      "mutedText": "#55605c"
    },
    "fonts": {
      "heading": "transitional",
      "body": "system-ui"
    },
    "radius": "small"
  },
  "context": {
    "site": {
      "firmName": "Harbor & Pine Wealth Partners",
      "logo": {
        "$type": "image",
        "mediaId": "22222222-2222-4222-8222-00000000000c",
        "alt": "Harbor & Pine logo"
      },
      "homeHref": "/s/demo/",
      "nav": [
        {
          "pageId": "11111111-1111-4111-8111-000000000001",
          "title": "Home",
          "href": "/s/demo/",
          "current": false
        },
        {
          "pageId": "11111111-1111-4111-8111-000000000002",
          "title": "About",
          "href": "/s/demo/about",
          "current": true
        },
        {
          "pageId": "11111111-1111-4111-8111-000000000003",
          "title": "Contact",
          "href": "/s/demo/contact",
          "current": false
        }
      ]
    },
    "pageHrefs": {
      "11111111-1111-4111-8111-000000000001": "/s/demo/",
      "11111111-1111-4111-8111-000000000002": "/s/demo/about",
      "11111111-1111-4111-8111-000000000003": "/s/demo/contact"
    },
    "mediaBase": "/media/",
    "formAction": "/s/demo/_contact",
    "pageId": "11111111-1111-4111-8111-000000000002"
  },
  "definition": {
    "schemaVersion": 1,
    "root": {
      "$type": "section",
      "id": "root",
      "background": "primary",
      "paddingY": "sm",
      "width": "wide",
      "children": [
        {
          "$type": "columns",
          "id": "bar",
          "ratio": "3:1",
          "gap": "md",
          "valign": "center",
          "stackAt": "mobile",
          "columns": [
            {
              "children": [
                {
                  "$type": "nav",
                  "id": "nav"
                }
              ]
            },
            {
              "children": [
                {
                  "$type": "button",
                  "id": "cta",
                  "variant": "primary",
                  "align": "end",
                  "label": {
                    "key": "ctaLabel",
                    "label": "ctaLabel",
                    "type": "text",
                    "mode": "editable",
                    "required": false,
                    "default": {
                      "$type": "text",
                      "text": "Book a call"
                    }
                  },
                  "link": {
                    "key": "ctaLink",
                    "label": "ctaLink",
                    "type": "link",
                    "mode": "editable",
                    "required": false,
                    "default": {
                      "$type": "link",
                      "target": null
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "instance": {
    "id": "aaaaaaaa-0000-4000-8000-000000000004",
    "sectionTypeId": "bbbbbbbb-0000-4000-8000-000000000004",
    "version": 1,
    "lock": "none",
    "hidden": false,
    "values": {
      "ctaLink": {
        "$type": "link",
        "target": {
          "kind": "page",
          "pageId": "11111111-1111-4111-8111-000000000003"
        }
      }
    },
    "repeaters": {}
  }
}
