<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Strata.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The content schema is the single source of truth; embed it so validation never drifts from the file. -->
    <EmbeddedResource Include="..\..\schema\strata-content.schema.json" LogicalName="strata-content.schema.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Strata.Api.Tests" />
    <InternalsVisibleTo Include="Strata.Infrastructure.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Strata.Domain\Strata.Domain.csproj" />
  </ItemGroup>
</Project>
