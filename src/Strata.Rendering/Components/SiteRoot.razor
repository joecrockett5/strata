@* The .st-site wrapper carrying theme tokens. Mirrors SiteRoot.tsx. *@
<div class="@Css.ThemeClasses(Theme)" style="@Css.ThemeVariables(Theme)">@ChildContent</div>

@code {
    [Parameter, EditorRequired] public required Theme Theme { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
